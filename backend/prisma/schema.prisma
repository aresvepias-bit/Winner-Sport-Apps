// ==============================================================================
// Winner Sport Konveksi - Prisma Schema (PostgreSQL Multi-Schema)
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["winner_sport", "public"]
}

// -----------------------------------------------------------------------------
// 1. PENGGUNA & HAK AKSES
// -----------------------------------------------------------------------------
enum Role {
  OWNER
  ADMIN
  WAREHOUSE
  PRODUCTION
  SALES
  ACCOUNTING

  @@schema("winner_sport")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrdersCreated WorkOrder[]
  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 2. MASTER DATA (KATEGORI, SATUAN, KONTAK, KARYAWAN)
// -----------------------------------------------------------------------------
enum CategoryType {
  RAW_MATERIAL
  FINISHED_GOOD
  EXPENSE

  @@schema("winner_sport")
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType
  description String?
  createdAt   DateTime     @default(now())

  rawMaterials RawMaterial[]
  products     Product[]
  expenses     Expense[]

  @@schema("winner_sport")
}

model Unit {
  id          String   @id @default(cuid())
  name        String   @unique // Meter, Roll, Pcs, Kodi, Lusin, Kg
  symbol      String   // m, roll, pcs, kodi, lsn, kg
  ratioToPcs  Decimal? @default(1.0) @db.Decimal(10, 2) // Misal Kodi = 20, Lusin = 12
  description String?

  rawMaterials RawMaterial[]
  products     Product[]

  @@schema("winner_sport")
}

enum ContactType {
  SUPPLIER
  CUSTOMER
  BOTH

  @@schema("winner_sport")
}

model Contact {
  id             String      @id @default(cuid())
  name           String
  type           ContactType
  phone          String?
  email          String?
  address        String?
  companyName    String?
  paymentTerm    Int         @default(0) // Hari jatuh tempo
  creditLimit    Decimal     @default(0) @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]

  @@schema("winner_sport")
}

enum WageType {
  BORONGAN // Upah jahit per pcs
  HARIAN
  BULANAN

  @@schema("winner_sport")
}

model Employee {
  id          String    @id @default(cuid())
  name        String
  role        String    // Penjahit, Pemotong, Sablon/Bordir, Finishing, Gudang
  wageType    WageType  @default(BORONGAN)
  ratePerPcs  Decimal   @default(0) @db.Decimal(12, 2)
  baseSalary  Decimal   @default(0) @db.Decimal(12, 2)
  phone       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 3. MASTER ITEM (BAHAN BAKU & PRODUK JADI)
// -----------------------------------------------------------------------------
model RawMaterial {
  id           String    @id @default(cuid())
  sku          String    @unique
  name         String
  categoryId   String
  unitId       String
  standardCost Decimal   @default(0) @db.Decimal(15, 2)
  currentStock Decimal   @default(0) @db.Decimal(12, 2)
  minimumStock Decimal   @default(0) @db.Decimal(12, 2)
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  unit               Unit                @relation(fields: [unitId], references: [id])
  bomItems           BomItem[]
  workOrderMaterials WorkOrderMaterial[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]
  opnameItems        StockOpnameItem[]

  @@schema("winner_sport")
}

model Product {
  id           String    @id @default(cuid())
  sku          String    @unique
  name         String
  categoryId   String
  unitId       String
  standardCost Decimal   @default(0) @db.Decimal(15, 2) // HPP Acuan
  priceSatuan  Decimal   @default(0) @db.Decimal(15, 2) // Harga Eceran
  priceGrosir  Decimal   @default(0) @db.Decimal(15, 2) // Harga Grosir
  priceKodi    Decimal   @default(0) @db.Decimal(15, 2) // Harga per Kodi (20 pcs)
  currentStock Int       @default(0)
  minimumStock Int       @default(0)
  description  String?
  imageUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category        Category          @relation(fields: [categoryId], references: [id])
  unit            Unit              @relation(fields: [unitId], references: [id])
  boms            Bom[]
  workOrders      WorkOrder[]
  salesOrderItems SalesOrderItem[]
  stockMovements  StockMovement[]
  opnameItems     StockOpnameItem[]

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 4. BILL OF MATERIALS (BOM / FORMULA RESEP)
// -----------------------------------------------------------------------------
model Bom {
  id           String    @id @default(cuid())
  productId    String
  name         String    // Misal: BOM Kaos Combed 30s Standar v1
  version      String    @default("v1.0")
  wastePercent Decimal   @default(3.0) @db.Decimal(5, 2) // Estimasi kain perca / waste %
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product    Product     @relation(fields: [productId], references: [id])
  items      BomItem[]
  workOrders WorkOrder[]

  @@schema("winner_sport")
}

model BomItem {
  id             String      @id @default(cuid())
  bomId          String
  rawMaterialId  String
  quantityPerPcs Decimal     @db.Decimal(10, 4) // Kebutuhan bahan untuk 1 pcs baju
  wasteAllowance Decimal     @default(0) @db.Decimal(10, 4) // Tambahan toleransi

  bom         Bom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 5. MANUFAKTUR & PRODUKSI (WORK ORDER / SPK)
// -----------------------------------------------------------------------------
enum WorkOrderStatus {
  DRAFT
  PENDING_MATERIAL
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("winner_sport")
}

model WorkOrder {
  id                 String          @id @default(cuid())
  woNumber           String          @unique // SPK-2026-0001
  productId          String
  bomId              String?
  targetQty          Int             // Rencana produksi
  completedQty       Int             @default(0) // Hasil grade A
  scrapQty           Int             @default(0) // Rijek / cacat
  status             WorkOrderStatus @default(DRAFT)
  startDate          DateTime?
  dueDate            DateTime?
  completedDate      DateTime?
  notes              String?
  createdById        String?

  // Akumulasi Biaya & HPP Aktual
  materialCost        Decimal        @default(0) @db.Decimal(15, 2)
  sewingCost          Decimal        @default(0) @db.Decimal(15, 2) // Biaya jahit
  laborCost           Decimal        @default(0) @db.Decimal(15, 2) // Upah potong/finishing
  overheadCost        Decimal        @default(0) @db.Decimal(15, 2) // Listrik, jarum, dll
  totalProductionCost Decimal        @default(0) @db.Decimal(15, 2)
  hppPerPcs           Decimal        @default(0) @db.Decimal(15, 2) // totalCost / completedQty

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  product   Product             @relation(fields: [productId], references: [id])
  bom       Bom?                @relation(fields: [bomId], references: [id])
  createdBy User?               @relation(fields: [createdById], references: [id])
  materials WorkOrderMaterial[]

  @@schema("winner_sport")
}

model WorkOrderMaterial {
  id              String      @id @default(cuid())
  workOrderId     String
  rawMaterialId   String
  plannedQty      Decimal     @db.Decimal(10, 2)
  actualIssuedQty Decimal     @default(0) @db.Decimal(10, 2)
  unitCost        Decimal     @default(0) @db.Decimal(15, 2)
  subtotal        Decimal     @default(0) @db.Decimal(15, 2)

  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 6. INVENTORI, MUTASI STOK & OPNAME
// -----------------------------------------------------------------------------
enum ItemType {
  RAW_MATERIAL
  PRODUCT

  @@schema("winner_sport")
}

enum MovementType {
  GOODS_RECEIPT     // Masuk dari supplier
  MATERIAL_ISSUE    // Keluar ke produksi SPK
  PRODUCTION_RESULT // Masuk hasil produksi
  SALES_ISSUE       // Keluar karena terjual
  STOCK_ADJUSTMENT  // Penyesuaian opname
  SCRAP_WASTE       // Rusak / kain sisa

  @@schema("winner_sport")
}

model StockMovement {
  id            String       @id @default(cuid())
  itemType      ItemType
  rawMaterialId String?
  productId     String?
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 2) // Positif atau negatif
  balanceAfter  Decimal      @db.Decimal(12, 2)
  referenceType String?      // PO, WO, SO, OPNAME, MANUAL
  referenceId   String?      // Nomor dokumen terkait
  notes         String?
  createdAt     DateTime     @default(now())

  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])

  @@schema("winner_sport")
}

model StockOpname {
  id           String            @id @default(cuid())
  opnameNumber String            @unique // OP-2026-0001
  date         DateTime          @default(now())
  itemType     ItemType
  status       String            @default("DRAFT") // DRAFT, APPLIED
  notes        String?
  createdAt    DateTime          @default(now())

  items StockOpnameItem[]

  @@schema("winner_sport")
}

model StockOpnameItem {
  id            String       @id @default(cuid())
  opnameId      String
  rawMaterialId String?
  productId     String?
  systemQty     Decimal      @db.Decimal(12, 2)
  physicalQty   Decimal      @db.Decimal(12, 2)
  difference    Decimal      @db.Decimal(12, 2)
  notes         String?

  opname      StockOpname  @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 7. PENJUALAN (SALES ORDER & INVOICE)
// -----------------------------------------------------------------------------
enum SalesOrderType {
  SATUAN
  BULK_GROSIR
  KODIAN
  CUSTOM_ORDER
  PROJECT

  @@schema("winner_sport")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  COMPLETED
  CANCELLED

  @@schema("winner_sport")
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID

  @@schema("winner_sport")
}

model SalesOrder {
  id            String         @id @default(cuid())
  soNumber      String         @unique // SO-2026-0001
  customerId    String
  orderDate     DateTime       @default(now())
  dueDate       DateTime?
  orderType     SalesOrderType @default(SATUAN)
  status        OrderStatus    @default(DRAFT)
  paymentStatus PaymentStatus  @default(UNPAID)
  subtotal      Decimal        @default(0) @db.Decimal(15, 2)
  discount      Decimal        @default(0) @db.Decimal(15, 2)
  tax           Decimal        @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal        @default(0) @db.Decimal(15, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(15, 2)
  notes         String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  customer  Contact          @relation(fields: [customerId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id])
  items     SalesOrderItem[]
  invoices  Invoice[]

  @@schema("winner_sport")
}

model SalesOrderItem {
  id                String   @id @default(cuid())
  salesOrderId      String
  productId         String?
  customDescription String?  // Untuk custom jersey/sablon khusus
  quantity          Int
  unitName          String   @default("pcs") // pcs, kodi (20 pcs), lusin
  pricePerUnit      Decimal  @db.Decimal(15, 2)
  subtotal          Decimal  @db.Decimal(15, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])

  @@schema("winner_sport")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // INV-2026-0001
  salesOrderId  String?
  customerId    String
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  totalAmount   Decimal       @db.Decimal(15, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(15, 2)
  status        PaymentStatus @default(UNPAID)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  customer   Contact     @relation(fields: [customerId], references: [id])
  payments   Payment[]

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 8. PURCHASING (ORDER BAHAN DARI SUPPLIER)
// -----------------------------------------------------------------------------
model PurchaseOrder {
  id            String    @id @default(cuid())
  poNumber      String    @unique // PO-2026-0001
  supplierId    String
  orderDate     DateTime  @default(now())
  expectedDate  DateTime?
  status        String    @default("DRAFT") // DRAFT, ORDERED, RECEIVED, CANCELLED
  totalAmount   Decimal   @default(0) @db.Decimal(15, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(15, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplier  Contact             @relation(fields: [supplierId], references: [id])
  createdBy User?               @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  payments  Payment[]

  @@schema("winner_sport")
}

model PurchaseOrderItem {
  id              String      @id @default(cuid())
  purchaseOrderId String
  rawMaterialId   String
  quantity        Decimal     @db.Decimal(10, 2)
  unitPrice       Decimal     @db.Decimal(15, 2)
  subtotal        Decimal     @db.Decimal(15, 2)
  receivedQty     Decimal     @default(0) @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  @@schema("winner_sport")
}

// -----------------------------------------------------------------------------
// 9. ACCOUNTING, KAS/BANK, EXPENSE & JURNAL
// -----------------------------------------------------------------------------
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COGS

  @@schema("winner_sport")
}

model Account {
  id          String      @id @default(cuid())
  code        String      @unique // Misal 1001 (Kas), 1002 (BCA), 4001 (Omzet)
  name        String
  type        AccountType
  balance     Decimal     @default(0) @db.Decimal(15, 2)
  description String?

  expenses     Expense[]
  payments     Payment[]
  journalItems JournalItem[]

  @@schema("winner_sport")
}

enum PaymentType {
  INCOME  // Penerimaan penjualan / pelunasan piutang
  EXPENSE // Pembayaran hutang / operasional

  @@schema("winner_sport")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QRIS
  GIRO

  @@schema("winner_sport")
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique // PAY-2026-0001
  type            PaymentType
  method          PaymentMethod @default(BANK_TRANSFER)
  amount          Decimal       @db.Decimal(15, 2)
  date            DateTime      @default(now())
  accountId       String?       // Rekening kas/bank penampung
  invoiceId       String?       // Terkait invoice penjualan
  purchaseOrderId String?       // Terkait PO supplier
  referenceNumber String?       // Bukti transfer bank
  notes           String?
  createdAt       DateTime      @default(now())

  account       Account?       @relation(fields: [accountId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@schema("winner_sport")
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique // EXP-2026-0001
  date          DateTime @default(now())
  categoryId    String?
  accountId     String?  // Akun kas/bank yang keluar
  amount        Decimal  @db.Decimal(15, 2)
  recipient     String?  // Penerima dana
  notes         String?
  createdAt     DateTime @default(now())

  category Category? @relation(fields: [categoryId], references: [id])
  account  Account?  @relation(fields: [accountId], references: [id])

  @@schema("winner_sport")
}

model JournalEntry {
  id            String        @id @default(cuid())
  entryNumber   String        @unique // JRN-2026-0001
  date          DateTime      @default(now())
  description   String
  referenceType String?       // SO, WO, PO, EXP
  referenceId   String?
  createdAt     DateTime      @default(now())

  items JournalItem[]

  @@schema("winner_sport")
}

model JournalItem {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0) @db.Decimal(15, 2)
  credit         Decimal  @default(0) @db.Decimal(15, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@schema("winner_sport")
}

# =============================================================================
# Winner Sport - Backend. Salin jadi .env (lokal) atau isi sebagai
# Environment Variables di Vercel. Jangan pernah commit nilai aslinya.
# =============================================================================

# --- WAJIB ---------------------------------------------------------------
# Supabase, mode pooler transaksi (port 6543) untuk aplikasi
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Supabase, koneksi langsung (port 5432) untuk prisma db push / migrate
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Kunci tanda tangan token. WAJIB acak; server menolak menyala bila kosong
# atau masih memakai default lama yang sudah bocor.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- WAJIB DI PRODUKSI ----------------------------------------------------
# Alamat frontend yang boleh memanggil API, dipisah koma. Bila kosong, hanya
# localhost & jaringan lokal yang diterima (aman, tapi tidak bisa dipakai publik).
CORS_ORIGINS=https://nama-proyek.vercel.app

# --- OPSIONAL (nilai di bawah adalah bawaannya) ---------------------------
PORT=5005
JWT_EXPIRES_IN=12h
SESSION_IDLE_MINUTES=30
BCRYPT_COST=12
BODY_LIMIT=1mb
LOGIN_AUDIT_RETENTION_DAYS=90
# Masa berlaku cache hak akses & satuan. Di serverless jangan dibuat terlalu
# panjang: instance lain baru ikut berubah setelah cache-nya kedaluwarsa.
ROLE_POLICY_TTL_SECONDS=20
UNIT_CACHE_TTL_SECONDS=60
# Ukuran pool koneksi. Di Vercel otomatis 1 agar kuota Supabase tidak habis.
DB_POOL_MAX=10
